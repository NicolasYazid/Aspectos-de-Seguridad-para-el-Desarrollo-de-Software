# ============================================
# .gitignore para proyectos Java/C# en NetBeans e IntelliJ IDEA
# ============================================

# ---------- Archivos compilados (Java) ----------
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# ---------- Carpetas de compilación ----------
target/
build/
dist/
out/
bin/
obj/
classes/

# ---------- Gradle ----------
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# ---------- Maven ----------
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml

# ---------- IntelliJ IDEA ----------
.idea/
*.iml
*.ipr
*.iws
.idea_modules/
atlassian-ide-plugin.xml

# ---------- NetBeans ----------
nbproject/private/
nbproject/*.properties
nbproject/*.xml
!nbproject/project.properties
!nbproject/project.xml
build/
dist/
nbbuild/
nbdist/
nbactions.xml
nb-configuration.xml
.nb-gradle/
*.nbm

# ---------- C# / .NET (por si usas C#) ----------
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.pdb
*.cache
packages/
*.nupkg
TestResults/

# ---------- Logs y temporales ----------
*.log
*.tmp
*.temp
*.bak
*.swp
*~

# ---------- Archivos del sistema operativo ----------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ---------- Archivos sensibles / configuración local ----------
.env
*.env
local.properties